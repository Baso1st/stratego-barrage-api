{
  "openapi": "3.1.1",
  "info": {
    "title": "Stratego Barrage API",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/games": {
      "post": {
        "tags": [
          "Games"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartGameRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayerView"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/games/{id}": {
      "get": {
        "tags": [
          "Games"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayerView"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/games/{id}/moves": {
      "post": {
        "tags": [
          "Games"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MoveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayerView"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/games/{id}/resign": {
      "post": {
        "tags": [
          "Games"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayerView"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EndReason": {
        "enum": [
          "flag",
          "no-moves",
          "draw",
          "resigned",
          "left",
          "timed-out"
        ]
      },
      "GameMode": {
        "enum": [
          "vs-bot",
          "vs-person"
        ]
      },
      "GamePlayer": {
        "required": [
          "playerId",
          "kind"
        ],
        "type": "object",
        "properties": {
          "playerId": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/PlayerKind"
          }
        }
      },
      "GamePlayers": {
        "required": [
          "red",
          "blue"
        ],
        "type": "object",
        "properties": {
          "red": {
            "$ref": "#/components/schemas/GamePlayer"
          },
          "blue": {
            "$ref": "#/components/schemas/GamePlayer"
          }
        }
      },
      "GameResult": {
        "required": [
          "winner",
          "reason"
        ],
        "type": "object",
        "properties": {
          "winner": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Side"
              }
            ]
          },
          "reason": {
            "$ref": "#/components/schemas/EndReason"
          }
        }
      },
      "GameStatus": {
        "enum": [
          "waiting",
          "setup",
          "playing",
          "over",
          "cancelled"
        ]
      },
      "Move": {
        "required": [
          "from",
          "to"
        ],
        "type": "object",
        "properties": {
          "from": {
            "$ref": "#/components/schemas/Square"
          },
          "to": {
            "$ref": "#/components/schemas/Square"
          }
        }
      },
      "MoveRequest": {
        "required": [
          "from",
          "to",
          "expectedVersion"
        ],
        "type": "object",
        "properties": {
          "from": {
            "$ref": "#/components/schemas/Square"
          },
          "to": {
            "$ref": "#/components/schemas/Square"
          },
          "expectedVersion": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "Piece": {
        "required": [
          "side",
          "square"
        ],
        "type": "object",
        "properties": {
          "side": {
            "$ref": "#/components/schemas/Side"
          },
          "square": {
            "$ref": "#/components/schemas/Square"
          }
        }
      },
      "PlayerKind": {
        "enum": [
          "human",
          "bot"
        ]
      },
      "PlayerView": {
        "required": [
          "gameId",
          "mode",
          "status",
          "you",
          "players",
          "version",
          "toMove",
          "pieces",
          "legalMoves",
          "turnDeadline",
          "result",
          "serverTime"
        ],
        "type": "object",
        "properties": {
          "gameId": {
            "type": "string"
          },
          "mode": {
            "$ref": "#/components/schemas/GameMode"
          },
          "status": {
            "$ref": "#/components/schemas/GameStatus"
          },
          "you": {
            "$ref": "#/components/schemas/Side"
          },
          "players": {
            "$ref": "#/components/schemas/GamePlayers"
          },
          "version": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "toMove": {
            "$ref": "#/components/schemas/Side"
          },
          "pieces": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Piece"
            }
          },
          "legalMoves": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Move"
            }
          },
          "turnDeadline": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/GameResult"
              }
            ]
          },
          "serverTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Side": {
        "enum": [
          "red",
          "blue"
        ]
      },
      "Square": {
        "required": [
          "row",
          "col"
        ],
        "type": "object",
        "properties": {
          "row": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "col": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "StartGameRequest": {
        "required": [
          "mode"
        ],
        "type": "object",
        "properties": {
          "mode": {
            "$ref": "#/components/schemas/GameMode"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Games"
    }
  ]
}